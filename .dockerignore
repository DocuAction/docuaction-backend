# .dockerignore — DocuAction AI backend
# Copyright © 2024–2026 Alliance Global Tech, Inc. All rights reserved.
# Keep build context small and secret-free.

# Version control & CI
.git
.gitignore
.github

# Python bytecode & caches
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments (all common names, including the Azure "antenv")
.venv/
venv/
antenv/
env/

# Secrets & environment files — NEVER copy real secrets into the image.
.env
.env.*
# NOTE: .env.example is intentionally excluded from the image as well; it is a
# template only and is not needed at runtime.

# Frontend / node artifacts (not part of the backend image)
node_modules/

# Runtime-generated & user content
uploads/

# Documentation (not needed at runtime)
docs/

# Tests (not shipped in the runtime image)
tests/

# Editor / IDE / OS cruft
.editorconfig
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Tooling & agent config
.pre-commit-config.yaml
.secrets.baseline
.claude/

# Keep Alembic migration versions IN the image (do NOT ignore alembic/versions).

# ── 2026-10-26: non-runtime content that was still reaching `COPY . .` ─────────
# Evidence, spreadsheets, archives, fixtures, local reports and tooling folders are
# never runtime assets. Runtime data that IS required stays: app/**, alembic/**,
# requirements.txt, alembic.ini, Procfile, pyproject.toml (and app/bulletin_intelligence/
# data/*.csv, which the application reads).
qa-evidence/
security-platform/
bulletin-stabilization/
infra/
*.zip
*.7z
*.xlsx
*.xlsm
*.xls
*.docx
*.pptx
*.pdf
*.psv
*.log
test-results.xml
# Stray root-level files (empty placeholders and one-off patch scripts)
patch.py
fix2.py
fix3.py
curl
config
python
*Sonnet
nixpacks.toml
railway.json
stackhawk.yml
