__pycache__/
*.pyc
.env
uploads/
*.db
.venv/
venv/
.pytest_cache/

# One-off generated FCC briefing HTML preview (not source; release docs stay tracked)
pv.html

# Deployment artifacts - built, never committed.
# pydeps_new/ is the staging copy of the vendored Linux wheels (~5,500 files);
# prod-deploy.prev.zip is the rollback copy of the previous prod artifact.
dev-deploy.zip
deploy.zip
# Glob rather than named files: rollback generations (prod-deploy.prev2.zip) and
# commit-tagged builds (prod-deploy-<sha>.zip) are ~60 MB each and were slipping
# past the old exact-name list into `git add -A`.
prod-deploy*.zip
# Staging tree the prod artifact is assembled in.
prod-build/
pydeps/
pydeps_new/

# Claude Code local settings — has contained plaintext DB connection strings
.claude/

# Holds rotated dev credentials — must never be committed
docs/SESSION_STATE.md

# Generated by scripts/reset_qa_passwords.py — live QA account passwords in plaintext
docs/QA_CREDENTIALS.md

# Runtime logs and test artifacts — regenerated on every run, never source.
logs/*.log
results.xml
# JUnit output from the QA regression runs (--junit-xml). Regenerated on every
# run and machine-specific; the pass/fail record belongs in CI, not in git.
results_*.xml
