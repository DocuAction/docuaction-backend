# ─────────────────────────────────────────────────────────────────────────────
# DocuAction AI — Backend environment configuration (EXAMPLE)
#
# Copy to `.env` and fill in environment-appropriate values.
#   cp .env.example .env
#
# NEVER commit a real secret. Placeholders below are illustrative only.
# Authoritative reference: docs/deployment/environment-topology.md (Section 5).
# Prefer Azure Key Vault references for all secret-bearing settings.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (REQUIRED at boot — the app refuses to start without these) ──────────
# PostgreSQL connection string. SSL is required on Azure PostgreSQL. The app
# rewrites a plain postgresql:// URL to the async (asyncpg) driver automatically.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<db>?ssl=require
# JWT/crypto signing key. MUST be at least 64 high-entropy characters or the app
# refuses to start. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<64-plus-char-random-string>

# Deployment tier. "production" (default) hides dev-only surfaces; "development"
# enables /docs and relaxes dev-only guards.
ENVIRONMENT=production
# Comma-separated trusted Host header values (TrustedHost). An unlisted host => 400.
ALLOWED_HOSTS=docuaction-dev.azurewebsites.net,localhost
# Comma-separated CORS-allowed origins (a.k.a. CORS_ORIGINS).
ALLOWED_ORIGINS=https://app.docuaction.io
# Expose Swagger/OpenAPI in production (either flag). Leave false in production.
ENABLE_DOCS=false
ENABLE_OPENAPI=false
# Enable the APScheduler daily jobs on exactly ONE instance sharing a database.
ENABLE_SCHEDULER=false
# Storage backend and upload location.
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
# Data retention window (days).
DATA_RETENTION_DAYS=365
# Registration hardening.
REQUIRE_ADMIN_APPROVAL=true
BLOCK_DISPOSABLE_EMAILS=true

# ── AI providers ──────────────────────────────────────────────────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=<anthropic-key>
ANTHROPIC_MODEL=<model-id>
ANTHROPIC_SONNET_MODEL=<model-id>
OPENAI_API_KEY=<openai-key>
GEMINI_API_KEY=<gemini-key>
PERPLEXITY_API_KEY=<perplexity-key>
TAVILY_API_KEY=<tavily-key>
WHISPER_MODEL=whisper-1

# ── Identity / SSO ────────────────────────────────────────────────────────────
AZURE_AD_CLIENT_ID=<guid>
AZURE_AD_CLIENT_SECRET=<secret>
AZURE_AD_TENANT_ID=<guid>
AZURE_AD_DEFAULT_ROLE=viewer
AZURE_AD_POST_LOGIN_REDIRECT=https://app.docuaction.io/auth/callback
MICROSOFT_CLIENT_ID=<guid>
MICROSOFT_CLIENT_SECRET=<secret>
MICROSOFT_TENANT_ID=<guid>
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<secret>
ZOOM_CLIENT_ID=<zoom-client-id>
ZOOM_CLIENT_SECRET=<secret>

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=<sendgrid-key>
EMAIL_FROM=no-reply@docuaction.io
EMAIL_FROM_NAME=DocuAction
MAIL_FROM=no-reply@docuaction.io
MAIL_FROM_NAME=DocuAction

# ── TEFCA / connectors ────────────────────────────────────────────────────────
SAM_GOV_API_KEY=<sam-key>
RCE_DIRECTORY_API_KEY=<rce-key>
IQVIA_ONEKEY_API_KEY=<iqvia-key>
TEFCA_ALERT_FROM=alerts@docuaction.io
TEFCA_ALERT_RECIPIENTS=security@agtbi.com

# USPS APIs v3 (OAuth 2.0) — OPTIONAL address standardization.
# Leave unset and address comparison runs on code normalization alone: no
# network, no cost, and identical behaviour to before this integration existed.
# Setting both values and restarting activates it; no code change is needed.
# NOT the same as the legacy USPS_API_USER_ID used by usps_connector.py.
USPS_CLIENT_ID=<usps-client-id>
USPS_CLIENT_SECRET=<usps-client-secret>
# production -> apis.usps.com | testing -> apis-tem.usps.com
USPS_ENV=production
USPS_TIMEOUT_S=10
ENABLE_QA_MONITOR=false
QA_MONITOR_INTERVAL_MIN=60
QA_BASE_URL=https://api-prod.docuaction.io

# ── Bulletin Intelligence & external data ─────────────────────────────────────
NEWSAPI_KEY=<newsapi-key>
NEWSAPI_AI_KEY=<newsapi-ai-key>
CONGRESS_API_KEY=<congress-key>
GOVINFO_API_KEY=<govinfo-key>
YOUTUBE_API_KEY=<youtube-key>
REDDIT_CLIENT_ID=<reddit-client-id>
REDDIT_CLIENT_SECRET=<secret>
# BULLETIN_* feature flags gate the Bulletin Intelligence module (default OFF).
# See docs/deployment/environment-topology.md §5.6 for the full list.
BULLETIN_AUTH_ENABLED=false
BULLETIN_RATE_LIMIT_ENABLED=false
BULLETIN_AUDIT_ENABLED=false
BULLETIN_PUBLIC_BASE_URL=https://api-prod.docuaction.io
BULLETIN_SEND_FROM=no-reply@docuaction.io
BULLETIN_ALERT_EMAIL=security@agtbi.com
# Which body a briefing email carries.
#   classic — short summary + "VIEW FULL BRIEFING" button (default)
#   modern  — full Outlook-Classic-safe article list
# Read per send, so switching is an app-setting change plus a restart, not a
# deploy. Anything unrecognised is treated as classic. Preview either body first
# at GET /api/v1/bulletin/email-preview/{briefing_id}, or send one off the
# default with POST /send/{agency}/{briefing_id}?template_version=modern.
EMAIL_TEMPLATE_VERSION=classic

# ── URLs ──────────────────────────────────────────────────────────────────────
APP_URL=https://app.docuaction.io
APP_BASE_URL=https://app.docuaction.io
API_PUBLIC_URL=https://api-prod.docuaction.io
PUBLIC_BASE_URL=https://api-prod.docuaction.io
