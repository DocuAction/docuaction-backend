{
  "info": {
    "name": "DocuAction TEFCA ARC — API integration",
    "_postman_id": "d0c0ac70-17e5-4a00-b0b0-docuaction0001",
    "description": "Deterministic API integration tests against an ISOLATED backend seeded by scripts/seed_integration_fixtures.py. Postman Collection v2.1.0 — imports into the Postman app and is driven on the command line by the Postman CLI via tests/postman/run.mjs. Two modes: in BASELINE mode the folders tagged (requires #193)/(requires #194) assert fully when those routes are present and otherwise record a clear CONDITIONAL 'not on this build' result (never a silent skip); in RELEASE-CANDIDATE mode (rc_mode=yes, run against the combined #193+#194 candidate revision) those routes are REQUIRED and a missing capability FAILS. Never point this at production; baseUrl must be a local/isolated host.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8010" },
    { "key": "viewer_email", "value": "integration-viewer@synthetic-test.docuaction.invalid" },
    { "key": "viewer_password", "value": "" },
    { "key": "reviewer_email", "value": "integration-reviewer@synthetic-test.docuaction.invalid" },
    { "key": "reviewer_password", "value": "" },
    { "key": "qalead_email", "value": "integration-qalead@synthetic-test.docuaction.invalid" },
    { "key": "qalead_password", "value": "" },
    { "key": "pm_email", "value": "integration-pm@synthetic-test.docuaction.invalid" },
    { "key": "pm_password", "value": "" },
    { "key": "intake_id", "value": "" },
    { "key": "job_id", "value": "" },
    { "key": "candidate_entity_id", "value": "" },
    { "key": "viewer_token", "value": "" },
    { "key": "reviewer_token", "value": "" },
    { "key": "qalead_token", "value": "" },
    { "key": "pm_token", "value": "" },
    { "key": "sam_extract_present", "value": "" },
    { "key": "snapshot_present", "value": "" },
    { "key": "rc_mode", "value": "no" },
    { "key": "pdf_available", "value": "" }
  ],
  "item": [
    {
      "name": "0. Health & build identity",
      "item": [
        {
          "name": "GET /health — healthy + build identity",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('status is healthy', () => pm.expect(b.status).to.eql('healthy'));",
              "pm.test('carries a build identity (git_sha key present)', () => pm.expect(b).to.have.property('git_sha'));",
              "pm.test('names the service', () => pm.expect(b.service).to.be.a('string').and.not.empty);",
              "pm.test('reports module map', () => pm.expect(b.modules).to.be.an('object'));"
            ] } }
          ]
        }
      ]
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "POST /api/auth/login — reviewer success",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"{{reviewer_email}}\",\"password\":\"{{reviewer_password}}\"}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('bearer access_token returned', () => { pm.expect(b.token_type).to.eql('bearer'); pm.expect(b.access_token).to.be.a('string').and.not.empty; });",
              "pm.test('user carries the reviewer role', () => pm.expect(b.user && b.user.role).to.eql('reviewer'));",
              "pm.collectionVariables.set('reviewer_token', b.access_token);"
            ] } }
          ]
        },
        {
          "name": "POST /api/auth/login — viewer success",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"{{viewer_email}}\",\"password\":\"{{viewer_password}}\"}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('viewer role', () => pm.expect(b.user && b.user.role).to.eql('viewer'));",
              "pm.collectionVariables.set('viewer_token', b.access_token);"
            ] } }
          ]
        },
        {
          "name": "POST /api/auth/login — qalead success",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"{{qalead_email}}\",\"password\":\"{{qalead_password}}\"}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('qalead_token', pm.response.json().access_token);"
            ] } }
          ]
        },
        {
          "name": "POST /api/auth/login — program_manager success",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"{{pm_email}}\",\"password\":\"{{pm_password}}\"}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('pm_token', pm.response.json().access_token);"
            ] } }
          ]
        },
        {
          "name": "POST /api/auth/login — wrong password rejected (401)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"{{reviewer_email}}\",\"password\":\"definitely-not-the-password\"}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('401 invalid credentials', () => pm.response.to.have.status(401));",
              "pm.test('no token leaked on failure', () => pm.expect(pm.response.text()).to.not.include('access_token'));"
            ] } }
          ]
        },
        {
          "name": "POST /api/auth/login — empty password rejected (400 guard)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"{{reviewer_email}}\",\"password\":\"\"}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('empty password hits the route guard (400), not auth', () => pm.response.to.have.status(400));",
              "pm.test('no token on a malformed request', () => pm.expect(pm.response.text()).to.not.include('access_token'));"
            ] } }
          ]
        },
        {
          "name": "POST /api/auth/login — absent password field rejected (422 schema)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"{{reviewer_email}}\"}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('absent required field is a schema rejection (422)', () => pm.response.to.have.status(422));"
            ] } }
          ]
        },
        {
          "name": "GET delivery-jobs — anonymous rejected (401/403)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/tefca/rce/delivery-jobs?limit=5" },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('anonymous is rejected (not 200)', () => pm.expect([401,403]).to.include(pm.response.code));"
            ] } }
          ]
        }
      ]
    },
    {
      "name": "2. Authorization (viewer vs reviewer/QA/PM)",
      "item": [
        {
          "name": "Viewer CAN read verification-coverage (viewer floor, counts)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{viewer_token}}" } ],
            "url": "{{baseUrl}}/api/tefca/rce/deliveries/{{intake_id}}/verification-coverage"
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('viewer 200 on counts', () => pm.response.to.have.status(200));",
              "pm.test('coverage names sources', () => pm.expect(pm.response.json()).to.have.property('sources'));"
            ] } }
          ]
        },
        {
          "name": "Viewer CANNOT read exceptions (reviewer floor -> 403)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{viewer_token}}" } ],
            "url": "{{baseUrl}}/api/tefca/rce/deliveries/{{intake_id}}/exceptions"
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('viewer denied the evidence floor (403)', () => pm.response.to.have.status(403));"
            ] } }
          ]
        },
        {
          "name": "Reviewer CAN read exceptions (reviewer floor)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{reviewer_token}}" } ],
            "url": "{{baseUrl}}/api/tefca/rce/deliveries/{{intake_id}}/exceptions"
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('reviewer 200 on the evidence floor', () => pm.response.to.have.status(200));"
            ] } }
          ]
        }
      ]
    },
    {
      "name": "3. Synthetic delivery reconciliation",
      "item": [
        {
          "name": "GET reconciliation — persisted snapshot or live, population closes",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{reviewer_token}}" } ],
            "url": "{{baseUrl}}/api/tefca/rce/deliveries/{{intake_id}}/reconciliation"
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('carries the reconciliation equation', () => pm.expect(b).to.have.property('equation'));",
              "const eq = b.equation || {};",
              "pm.test('received accounts for its parts', () => { const parts=(eq.created||0)+(eq.updated||0)+(eq.matched_unchanged||0)+(eq.held||0)+(eq.rejected||0)+(eq.missing_key||0)+(eq.excluded||0); pm.expect(eq.received).to.eql(parts); });",
              "pm.test('names a source (persisted_snapshot or a live compute)', () => pm.expect(b.source || '').to.match(/snapshot|live/));"
            ] } }
          ]
        }
      ]
    },
    {
      "name": "4. SAM extract summary & candidates (requires #193)",
      "item": [
        {
          "name": "Preflight — is /sam-extract present on this build?",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{reviewer_token}}" } ],
            "url": "{{baseUrl}}/api/tefca/rce/deliveries/{{intake_id}}/sam-extract"
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "const present = pm.response.code !== 404;",
              "pm.collectionVariables.set('sam_extract_present', present ? 'yes' : 'no');",
              "const _rc = pm.variables.get('rc_mode') === 'yes';",
              "pm.test('route is deterministic (200 when present, 404 when the build predates #193)', () => pm.expect([200,404]).to.include(pm.response.code));",
              "if (_rc) { pm.test('REQUIRED on RC build: #193 /sam-extract is present (not 404)', () => { if (!present) throw new Error('RC candidate must expose /sam-extract (route returned 404)'); }); }",
              "else if (!present) { console.log('NOTE: /sam-extract absent — backend predates PR #193; folder 4 reports CONDITIONAL blocked-pending-#193.'); }"
            ] } }
          ]
        },
        {
          "name": "GET /sam-extract — reconciled per-entity outcomes",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{reviewer_token}}" } ],
            "url": "{{baseUrl}}/api/tefca/rce/deliveries/{{intake_id}}/sam-extract"
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "if (pm.collectionVariables.get('sam_extract_present') !== 'yes') { const _rc = pm.variables.get('rc_mode')==='yes'; pm.test((_rc?'REQUIRED on RC build':'CONDITIONAL (baseline)')+': #193 /sam-extract route present', () => { if (_rc) throw new Error('RC candidate must expose #193 /sam-extract (route returned 404)'); }); return; }",
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('reconciles to the eligible population', () => pm.expect(b.reconciles).to.be.true);",
              "pm.test('has the candidate outcome bucket', () => pm.expect(b.current_outcomes).to.have.property('candidate'));",
              "pm.test('the deterministic candidate is counted', () => pm.expect(b.current_outcomes.candidate).to.be.at.least(1));",
              "pm.test('does not claim exclusion clearance', () => pm.expect(JSON.stringify(b)).to.match(/never exclusion clearance|not.*exclusion clearance/i));"
            ] } }
          ]
        },
        {
          "name": "GET /sam-extract/candidates — lists the seeded candidate (reviewer)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{reviewer_token}}" } ],
            "url": "{{baseUrl}}/api/tefca/rce/deliveries/{{intake_id}}/sam-extract/candidates"
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "if (pm.collectionVariables.get('sam_extract_present') !== 'yes') { const _rc = pm.variables.get('rc_mode')==='yes'; pm.test((_rc?'REQUIRED on RC build':'CONDITIONAL (baseline)')+': #193 /sam-extract route present', () => { if (_rc) throw new Error('RC candidate must expose #193 /sam-extract (route returned 404)'); }); return; }",
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('at least one candidate', () => pm.expect(b.total).to.be.at.least(1));",
              "pm.test('the seeded candidate entity is present', () => { const ids=(b.items||[]).map(i=>i.entity_id); pm.expect(ids).to.include(pm.variables.get('candidate_entity_id')); });",
              "pm.test('candidate carries edition provenance', () => { const it=(b.items||[])[0]||{}; pm.expect(it.provenance||{}).to.have.property('extract_sha256'); });"
            ] } }
          ]
        },
        {
          "name": "GET /sam-extract/candidates — viewer DENIED (reviewer floor, requires #193)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{viewer_token}}" } ],
            "url": "{{baseUrl}}/api/tefca/rce/deliveries/{{intake_id}}/sam-extract/candidates"
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "if (pm.collectionVariables.get('sam_extract_present') !== 'yes') { const _rc = pm.variables.get('rc_mode')==='yes'; pm.test((_rc?'REQUIRED on RC build':'CONDITIONAL (baseline)')+': #193 /sam-extract route present', () => { if (_rc) throw new Error('RC candidate must expose #193 /sam-extract (route returned 404)'); }); return; }",
              "pm.test('viewer denied the candidate list (403)', () => pm.response.to.have.status(403));"
            ] } }
          ]
        }
      ]
    },
    {
      "name": "5. Candidate backfill dry-run — no writes (requires #193)",
      "item": [
        {
          "name": "POST backfill-issues?dry_run=true — reports a plan, writes nothing (PM)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{pm_token}}" } ],
            "url": "{{baseUrl}}/api/tefca/rce/deliveries/{{intake_id}}/sam-extract/candidates/backfill-issues?dry_run=true"
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "if (pm.collectionVariables.get('sam_extract_present') !== 'yes') { const _rc = pm.variables.get('rc_mode')==='yes'; pm.test((_rc?'REQUIRED on RC build':'CONDITIONAL (baseline)')+': #193 /sam-extract route present', () => { if (_rc) throw new Error('RC candidate must expose #193 /sam-extract (route returned 404)'); }); return; }",
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('dry_run is true', () => pm.expect(b.dry_run).to.be.true);",
              "pm.test('wrote nothing', () => pm.expect(b.written).to.eql(0));",
              "pm.test('reports what it WOULD write', () => pm.expect(b).to.have.property('would_write'));",
              "pm.test('write scope names only rce_issues', () => pm.expect(b.write_scope || '').to.match(/rce_issues/));"
            ] } }
          ]
        },
        {
          "name": "POST backfill-issues?dry_run=true — viewer DENIED (PM floor)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{viewer_token}}" } ],
            "url": "{{baseUrl}}/api/tefca/rce/deliveries/{{intake_id}}/sam-extract/candidates/backfill-issues?dry_run=true"
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "if (pm.collectionVariables.get('sam_extract_present') !== 'yes') { const _rc = pm.variables.get('rc_mode')==='yes'; pm.test((_rc?'REQUIRED on RC build':'CONDITIONAL (baseline)')+': #193 /sam-extract route present', () => { if (_rc) throw new Error('RC candidate must expose #193 /sam-extract (route returned 404)'); }); return; }",
              "pm.test('viewer denied the backfill (403)', () => pm.response.to.have.status(403));"
            ] } }
          ]
        }
      ]
    },
    {
      "name": "6. Snapshot request validation & role enforcement (requires #194)",
      "item": [
        {
          "name": "Preflight — is the MANUAL snapshot route present?",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{qalead_token}}" }, { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/api/tefca/rce/deliveries/{{intake_id}}/reconciliation/snapshots",
            "body": { "mode": "raw", "raw": "{\"reason\":\"\"}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "const present = pm.response.code !== 404;",
              "pm.collectionVariables.set('snapshot_present', present ? 'yes' : 'no');",
              "const _rc = pm.variables.get('rc_mode') === 'yes';",
              "pm.test('deterministic (422 blank reason when present, 404 when build predates #194)', () => pm.expect([422,404]).to.include(pm.response.code));",
              "if (_rc) { pm.test('REQUIRED on RC build: #194 snapshot route is present (not 404)', () => { if (!present) throw new Error('RC candidate must expose #194 snapshot route (route returned 404)'); }); }",
              "if (present) { pm.test('blank reason rejected (422)', () => pm.response.to.have.status(422)); }",
              "else if (!_rc) { console.log('NOTE: snapshot route absent — backend predates PR #194; folder 6 reports CONDITIONAL blocked-pending-#194.'); }"
            ] } }
          ]
        },
        {
          "name": "POST snapshots — viewer DENIED (qalead floor)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{viewer_token}}" }, { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/api/tefca/rce/deliveries/{{intake_id}}/reconciliation/snapshots",
            "body": { "mode": "raw", "raw": "{\"reason\":\"integration authorization probe — must be denied\"}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "if (pm.collectionVariables.get('snapshot_present') !== 'yes') { const _rc = pm.variables.get('rc_mode')==='yes'; pm.test((_rc?'REQUIRED on RC build':'CONDITIONAL (baseline)')+': #194 snapshot route present', () => { if (_rc) throw new Error('RC candidate must expose #194 snapshot route (route returned 404)'); }); return; }",
              "pm.test('viewer denied the snapshot persist (403)', () => pm.response.to.have.status(403));"
            ] } }
          ]
        }
      ]
    },
    {
      "name": "7. Report generation / status / download",
      "item": [
        {
          "name": "GET /api/reports/health/engine — PDF availability",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{reviewer_token}}" } ],
            "url": "{{baseUrl}}/api/reports/health/engine"
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const pdf = (pm.response.json() || {}).pdf || {};",
              "pm.collectionVariables.set('pdf_available', pdf.available ? 'yes' : 'no');",
              "pm.test('engine health reports PDF availability explicitly', () => pm.expect(pdf).to.have.property('available'));",
              "console.log('PDF engine available=' + pdf.available + ' reason=' + (pdf.reason||''));"
            ] } }
          ]
        },
        {
          "name": "GET /api/reports — list generated reports (reviewer)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{reviewer_token}}" } ],
            "url": "{{baseUrl}}/api/reports"
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('reviewer can list reports (200)', () => pm.response.to.have.status(200));"
            ] } }
          ]
        },
        {
          "name": "POST /api/reports/generate (CSV) — generic download coverage, always available",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{reviewer_token}}" }, { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/api/reports/generate",
            "body": { "mode": "raw", "raw": "{\"report_type\":\"delivery_processing\",\"format\":\"csv\",\"parameters\":{\"job_id\":\"{{job_id}}\",\"intake_id\":\"{{intake_id}}\"}}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('CSV report generates (200)', () => pm.response.to.have.status(200));",
              "const cd = pm.response.headers.get('Content-Disposition') || '';",
              "pm.test('CSV carries a .csv download filename', () => pm.expect(cd).to.match(/filename=.*\\.csv/i));",
              "const body = pm.response.text();",
              "pm.test('CSV is a real report, not an empty stub', () => pm.expect(body).to.match(/DA-ARC|Delivery Processing Report/));",
              "pm.test('CSV restates the reconciliation', () => pm.expect(body).to.match(/Intake id:|Reconciliation/i));",
              "pm.test('CSV is NOT a PDF (download coverage is distinct from PDF rendering)', () => pm.expect(body.slice(0,5)).to.not.equal('%PDF-'));"
            ] } }
          ]
        },
        {
          "name": "POST /api/reports/generate (PDF) — PDF RENDERING coverage, distinct from download",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{reviewer_token}}" }, { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/api/reports/generate",
            "body": { "mode": "raw", "raw": "{\"report_type\":\"delivery_processing\",\"format\":\"pdf\",\"parameters\":{\"job_id\":\"{{job_id}}\",\"intake_id\":\"{{intake_id}}\"}}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "// PDF rendering is a SEPARATE capability from the CSV download. A CSV",
              "// pass never counts as a PDF pass. If the PDF engine (WeasyPrint +",
              "// Pango/Cairo) is present this asserts real PDF bytes; if it is absent",
              "// this records an explicit BLOCKED failure naming the missing stack —",
              "// never a silent skip and never a green CSV substitution.",
              "const available = pm.collectionVariables.get('pdf_available') === 'yes';",
              "if (!available) { pm.test('PDF rendering capability BLOCKED (engine unavailable — install Pango/Cairo; GTK3 on Windows)', () => { throw new Error('PDF engine unavailable: install the native WeasyPrint stack for the PDF job, or report it explicitly blocked'); }); return; }",
              "pm.test('PDF report generates (200)', () => pm.response.to.have.status(200));",
              "pm.test('response Content-Type is a PDF', () => pm.expect(pm.response.headers.get('Content-Type')||'').to.match(/pdf/i));",
              "const cd = pm.response.headers.get('Content-Disposition') || '';",
              "pm.test('PDF carries a .pdf download filename', () => pm.expect(cd).to.match(/filename=.*\\.pdf/i));",
              "const bytes = pm.response.stream || Buffer.from(pm.response.text(), 'binary');",
              "const head = (pm.response.text() || '').slice(0,5);",
              "pm.test('real PDF magic bytes (%PDF-)', () => pm.expect(head).to.equal('%PDF-'));"
            ] } }
          ]
        }
      ]
    }
  ]
}
